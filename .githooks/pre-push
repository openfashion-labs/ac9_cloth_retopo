#!/bin/sh
# pre-push フック: push しようとしているコミットに個人情報・内部名が
# 含まれていないかを push 前にローカルで検査する（CI と同じ検査の前倒し）。
# 一度 push されたコミットは SHA 経由で恒久的に参照可能になるため、
# push 前に止めることが唯一確実な防御線になる。
#
# 導入手順:
#   1. git config core.hooksPath .githooks
#   2. 検査パターン（拡張正規表現1行）をエンジニアから受け取り、
#      .git/pii_block_pattern に保存する（このファイルはコミットされない）
#
# パターン未設定の場合は警告を出してスキップする（CI 側の検査は常に動く）。

pattern_file="$(git rev-parse --git-dir)/pii_block_pattern"
if [ ! -f "$pattern_file" ]; then
  echo "[pre-push] WARNING: $pattern_file がありません。PII検査をスキップします。" >&2
  echo "[pre-push] パターンをエンジニアから受け取り、上記パスに保存してください。" >&2
  exit 0
fi
BLOCK_PATTERN=$(cat "$pattern_file")
if [ -z "$BLOCK_PATTERN" ]; then
  exit 0
fi

# パターンが不正な正規表現だと grep が exit 2 を返し検査が素通りするため、先に検証する
printf '' | grep -qiE "$BLOCK_PATTERN" 2>/dev/null
if [ $? -gt 1 ]; then
  echo "[pre-push] ERROR: pii_block_pattern が正規表現として不正です。push を中止します。" >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # ブランチ削除の push には検査対象がない
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # 新規ブランチ: リモートのどのブランチにもまだ無いコミットだけを検査する
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  for c in $(git rev-list $range); do
    if git show -s --format='%an %ae %cn %ce %B' "$c" | grep -qiE "$BLOCK_PATTERN"; then
      echo "[pre-push] BLOCKED: commit $c のメッセージまたは author がブロックパターンにマッチしました。" >&2
      fail=1
    fi
    # CI は PR 全体の集約 diff を見るが、ここでは1コミットずつ検査する:
    # 「途中のコミットに入れて後のコミットで消す」形も push 前に検出するため
    if git show --format= "$c" | grep '^+' | grep -qiE "$BLOCK_PATTERN"; then
      echo "[pre-push] BLOCKED: commit $c の追加行がブロックパターンにマッチしました。" >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "[pre-push] push を中止しました。該当コミットを修正（reword / reauthor / 内容除去）してから" >&2
  echo "[pre-push] やり直してください。履歴がリモートに残る前に止まっています。" >&2
  exit 1
fi
exit 0
